---
import { getCollection, render } from "astro:content";
import ACEOsLayout from "../../layouts/ACEOsLayout.astro";

export async function getStaticPaths() {
  const aceoEntries = await getCollection("aceos");
  return aceoEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ACEOsLayout frontmatter={entry.data}>
  <Content />
</ACEOsLayout>